{
    "name": "rad-themes/radpack-crm",
    "description": "A free, full-featured CRM for Statamic: contacts, companies, quotes, invoices, tasks, email and more.",
    "type": "statamic-addon",
    "license": "MIT",
    "keywords": [
        "statamic",
        "statamic-addon",
        "crm",
        "contacts",
        "invoices",
        "quotes",
        "email-marketing",
        "automation",
        "stripe",
        "paypal"
    ],
    "homepage": "https://github.com/rad-themes/radpack-crm",
    "support": {
        "issues": "https://github.com/rad-themes/radpack-crm/issues",
        "source": "https://github.com/rad-themes/radpack-crm"
    },
    "autoload": {
        "psr-4": {
            "RadThemes\\RadpackCrm\\": "src",
            "RadThemes\\RadpackCrm\\Database\\Factories\\": "database/factories"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RadThemes\\RadpackCrm\\Tests\\": "tests"
        }
    },
    "require": {
        "php": "^8.3",
        "statamic/cms": "^6.0",
        "dompdf/dompdf": "^3.1"
    },
    "require-dev": {
        "orchestra/testbench": "^10.8"
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        }
    },
    "extra": {
        "statamic": {
            "name": "Radpack CRM",
            "description": "A free, full-featured CRM for Statamic."
        },
        "laravel": {
            "providers": [
                "RadThemes\\RadpackCrm\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "suggest": {
        "rad-themes/client-portal": "Show clients their invoices, quotes, payments and files in a portal (^1.1)"
    },
    "authors": [
        {
            "name": "Rad Themes",
            "homepage": "https://github.com/rad-themes"
        }
    ]
}
